<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Toplanti" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_600</item>
        <item name="colorOnPrimary">@color/ink_950</item>
        <item name="colorPrimaryContainer">@color/brand_100</item>
        <item name="colorOnPrimaryContainer">@color/brand_200</item>

        <item name="colorSecondary">@color/accent_600</item>
        <item name="colorOnSecondary">@color/ink_950</item>
        <item name="colorSecondaryContainer">@color/accent_100</item>
        <item name="colorOnSecondaryContainer">@color/accent_400</item>

        <item name="colorTertiary">@color/warn_600</item>
        <item name="colorTertiaryContainer">@color/warn_100</item>
        <item name="colorOnTertiaryContainer">@color/warn_400</item>

        <item name="colorError">@color/rec_600</item>
        <item name="colorOnError">@color/ink_950</item>
        <item name="colorErrorContainer">@color/rec_100</item>
        <item name="colorOnErrorContainer">@color/rec_400</item>

        <item name="android:colorBackground">@color/bg</item>
        <item name="colorOnBackground">@color/ink_100</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink_100</item>
        <item name="colorSurfaceVariant">@color/surface_high</item>
        <item name="colorOnSurfaceVariant">@color/ink_400</item>
        <item name="colorSurfaceContainerLowest">@color/ink_950</item>
        <item name="colorSurfaceContainerLow">@color/surface_low</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface_high</item>
        <item name="colorSurfaceContainerHighest">@color/surface_high</item>
        <item name="colorOutline">@color/ink_600</item>
        <item name="colorOutlineVariant">@color/ink_800</item>

        <item name="android:statusBarColor">?android:colorBackground</item>
        <item name="android:navigationBarColor">?android:colorBackground</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>

        <item name="materialCardViewStyle">@style/Widget.Toplanti.Card</item>
        <item name="materialButtonStyle">@style/Widget.Toplanti.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Toplanti.Button.Outlined</item>
        <item name="tabStyle">@style/Widget.Toplanti.Tabs</item>
        <item name="toolbarStyle">@style/Widget.Toplanti.Toolbar</item>
        <item name="extendedFloatingActionButtonStyle">@style/Widget.Toplanti.Fab</item>
        <item name="shapeAppearanceCornerLarge">@style/Shape.Toplanti.Large</item>
        <item name="shapeAppearanceCornerMedium">@style/Shape.Toplanti.Medium</item>
    </style>
</resources>
