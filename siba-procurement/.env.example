# ---------------------------------------------------------------------------
# Siba Procurement Command Center — environment template
# Copy to .env and adjust. NEVER commit .env or any real credential.
# ---------------------------------------------------------------------------

# Database ------------------------------------------------------------------
# SQLite for local development. The path is relative to the project root.
DATABASE_URL="file:./prisma/dev.db"
# PostgreSQL later (the schema is written to port cleanly):
# DATABASE_URL="postgresql://user:password@host:5432/siba_procurement?schema=public"

# ---------------------------------------------------------------------------
# Everything below is NOT used in Phase 1. The keys are listed so that future
# integrations have a documented home. All of them are SERVER-SIDE ONLY —
# never prefix a secret with NEXT_PUBLIC_, which would ship it to the browser.
# ---------------------------------------------------------------------------

# AI Procurement Analyst (src/services/ai) ----------------------------------
# Provider is selected here and nowhere else in the codebase.
# AI_PROVIDER="anthropic"          # anthropic | openai | none
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""

# Microsoft 365 / Outlook (supplier quotation email extraction) -------------
# MS_GRAPH_TENANT_ID=""
# MS_GRAPH_CLIENT_ID=""
# MS_GRAPH_CLIENT_SECRET=""

# Mikro ERP ------------------------------------------------------------------
# MIKRO_API_BASE_URL=""
# MIKRO_API_KEY=""

# Market data feeds (FX, commodities, freight) ------------------------------
# FX_API_KEY=""
# COMMODITY_API_KEY=""
# FREIGHT_API_KEY=""
