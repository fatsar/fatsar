<?xml version="1.0" encoding="utf-8"?>
<!-- Başlık alanı degradesi (aqua teması); altı yumuşak kavisli. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="@color/aqua_gradient_start"
        android:centerColor="@color/aqua_gradient_mid"
        android:endColor="@color/aqua_gradient_end"
        android:type="linear" />
    <corners
        android:bottomLeftRadius="28dp"
        android:bottomRightRadius="28dp" />
</shape>
