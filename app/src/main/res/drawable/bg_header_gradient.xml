<?xml version="1.0" encoding="utf-8"?>
<!-- Başlık alanı: gün doğumu degradesi, altı yumuşak kavisli.
     Sıcak kehribar→terrakota geçişi uygulamaya "ışık" hissi verir. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="@color/brand_gradient_start"
        android:centerColor="@color/brand_gradient_mid"
        android:endColor="@color/brand_gradient_end"
        android:type="linear" />
    <corners
        android:bottomLeftRadius="28dp"
        android:bottomRightRadius="28dp" />
</shape>
